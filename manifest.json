{
  "id": "/index.html",
  "name": "BiyaHERO — Offline Road Hazard & Traffic Map",
  "short_name": "BiyaHERO",
  "description": "Offline-first road hazard and traffic map for Luzon commuters. See live hazard reports, plan routes, and keep navigating even with zero signal.",
  "start_url": "./index.html",
  "scope": "./",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
